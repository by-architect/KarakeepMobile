<?xml version="1.0" encoding="utf-8"?>
<!-- Karakeep is self-hosted: servers are often plain http:// on a LAN or use a
     private CA. Trust user-installed CAs and allow cleartext, like the official
     Karakeep app does. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
